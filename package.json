{
  "name": "pulsometro-alexsters",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:production": "node scripts/setup.mjs --production",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "test:container": "node scripts/smoke-container.mjs",
    "dev": "concurrently -k -n api,web npm:dev:api npm:dev:web",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.json && vite build",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "test": "tsx --test server/app.test.ts src/pulse/totem-trigger.test.ts scripts/setup.test.mjs",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
