# Dedicated HTTP site for first-time certificate provisioning.
# Add as a NEW site; do not overwrite existing virtual hosts.
# After DNS resolves, enable HTTPS with certbot --nginx --redirect.
server {
    listen 80;
    listen [::]:80;
    server_name pulsestudio.alexsters.works;

    # The OBS token lives in the query string. Do not log complete request URLs.
    access_log off;
    error_log /var/log/nginx/pulsestudio-error.log crit;
    client_max_body_size 16k;
    client_body_timeout 10s;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 15s;
    }
}
