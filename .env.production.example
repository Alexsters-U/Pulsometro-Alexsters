# Copy to .env.production ON THE VPS, or use npm run setup:production.
# These values do not configure DNS, Nginx or TLS by themselves.
NODE_ENV=production
PUBLIC_ORIGIN=https://pulsestudio.alexsters.works
HOST=127.0.0.1
PORT=3010
APP_PORT=3010
DATA_DIR=./data
PULSE_STALE_MS=10000
# Generate three DIFFERENT secrets of at least 32 characters.
ADMIN_TOKEN=
INGEST_TOKEN=
OVERLAY_TOKEN=
